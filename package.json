{
  "name": "obsidian-prg-viewer",
  "version": "0.1.0",
  "description": "Read-only Project Graph (.prg) viewer for Obsidian",
  "type": "module",
  "license": "MIT",
  "author": "woolaof",
  "scripts": {
    "inspect": "tsx scripts/inspect-prg.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.10",
    "obsidian": "^1.14.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "main": "main.js"
}
